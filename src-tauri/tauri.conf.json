{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevDeck",
  "version": "1.0.0",
  "identifier": "dev.ezinrev.devdeck",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevDeck",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Friendly developer tools that work offline",
    "longDescription": "DevDeck: 70+ developer tools — JSON, YAML, JWT, Base64, certificates, regex, Docker and Kubernetes checks and more — in one desktop app. Everything runs on your computer.",
    "copyright": "© 2026 ezin-rev — MIT License",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
